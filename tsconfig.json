{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "types": ["node"]
  },
  "include": [
    "ai-slop-detector.ts",
    "rules.ts",
    "imports.ts",
    "tests/*.test.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
